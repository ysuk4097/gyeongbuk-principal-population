{
  "version": 1,
  "checked": "2026-11-08",
  "coverage": "2026년 공시 명단에 포함된 모동초의 2026.9.1 폐교와, 2026.10.15 의결된 2027.3.1 초등학교 개편을 반영. 확인한 일정만 수록하며 이후 미확정 학교는 존치 가정.",
  "sources": {
    "gb-2026-second-semester": {
      "title": "2026학년도 2학기 유·초·중학교 학급 편성 확정",
      "publisher": "경상북도교육청 행정과",
      "date": "2026-07-30",
      "url": "https://www.gbe.kr/news/na/ntt/selectNttInfo.do?mi=17643&nttSn=1633175",
      "finding": "2026년 9월 1일 자 모동초등학교 폐교와 학급 수 4개에서 0개로의 변경을 명시한다.",
      "limitations": "학교알리미 2026년 공시와 2학기 편성 자료는 시점이 다르다. 폐교 전 공시 학생 수를 현재 재학생 수로 해석할 수 없다."
    },
    "gb-2027-reorganization": {
      "title": "학령인구 변화와 지역 교육 여건을 반영해 29개교(원) 개편",
      "publisher": "경상북도교육청 행정과",
      "date": "2026-10-19",
      "url": "https://www.gbe.kr/news/na/ntt/selectNttInfo.do?mi=17643&nttSn=1656242",
      "finding": "2026년 10월 15일 도의회 본회의 최종 의결과 2027년 3월 1일 시행 예정인 개편을 발표했다. 초등학교 폐교 9곳과 분교장 개편·명칭 변경·교명 변경은 서로 다른 조치이다.",
      "limitations": "장래 시행 일정은 후속 개정으로 바뀔 수 있다. 이 자료는 2045년까지의 전체 폐교 명단이나 수용 학교별 학생 배치 인원을 제공하지 않는다."
    },
    "gb-2027-ordinance-review": {
      "title": "경상북도립학교 설치 조례 일부개정조례안 심사보고서, 3~5쪽",
      "publisher": "경상북도의회 교육위원회",
      "date": "2026-10-06 심사·2026-10-15 본회의 의결",
      "url": "https://council.gb.go.kr/kr/bill/download?uid=3D8E8675C4E4902C88EB434A22F7F6A1",
      "finding": "폐교 대상 초등학교·분교 9곳의 이름을 명시하고, 이전초의 분교장 전환과 원천·신평분교 소속 변경, 중모초의 중모모동초 교명 변경을 구분한다. 심사결과는 원안가결이다.",
      "limitations": "수용 학교를 확인하지 못한 경우 특정 학교로 임의 배치하지 않는다. 모형의 배치학교 미확인 인원은 실제 미배치 학생 수가 아니다."
    }
  },
